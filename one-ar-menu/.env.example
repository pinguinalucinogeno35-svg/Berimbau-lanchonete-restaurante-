# ONE AR Menu — variáveis de ambiente (copie para .env.local)
# Todas as variáveis VITE_* vão para o navegador: NUNCA coloque aqui a service role key.

# Fonte de dados: "demo" (dados fictícios locais) ou "supabase".
# Se ficar "supabase" sem URL/chave, o app volta sozinho para o modo demonstrativo.
VITE_DATA_SOURCE=demo

# Projeto Supabase (Settings > API). A anon key é pública e protegida por RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Slug do restaurante na tabela restaurants (o MVP atende um restaurante por deploy).
VITE_RESTAURANT_SLUG=restaurante-demonstrativo

# URL pública do app (usada nos QR codes). Em branco = origem atual do navegador.
VITE_PUBLIC_APP_URL=

# Identidade visual: one (neutra) ou berimbau (versão de teste). Na URL, ?tema=one|berimbau troca no aparelho.
VITE_BRAND=one
